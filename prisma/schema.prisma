generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  login    String   @id
  password String
  role     String?
  idTeach  Int?     @unique
  active   Boolean? @default(true)
  teacher  Teacher? @relation(fields: [idTeach], references: [id])
}

model Student {
  id                 Int                 @id @default(autoincrement())
  firstName          String?
  lastName           String?
  birthday           DateTime?
  idenelev           String?
  classId            Int?
  parentId           Int?
  photo              String?
  status             String?
  address            String?
  phone              String?
  gender             String?
  absences           Absence[]
  noteDevoirs        NoteDevoir[]
  payments           Payment[]
  sessionEvaluations SessionEvaluation[]
  classe             Class?              @relation(fields: [classId], references: [id])
  parent             Parent?             @relation(fields: [parentId], references: [id])

  chats Chat[]
  chatBlocked Boolean? @default(false)
  documents StudentDocument[]
  billets        Billet[]
  parentNotices  ParentAbsenceNotice[]
}

model Parent {
  id            Int            @id @default(autoincrement())
  name1         String?
  relation1     String?
  email1        String?
  phone1        String?
  name2         String?
  relation2     String?
  email2        String?
  phone2        String?
  username      String?
  password      String?
  active        Boolean?       @default(true)
  notifications Notification[]
  childrenIds   Student[]
}
model StudentDocument {
  id        Int      @id @default(autoincrement())
  studentId Int
  name      String
  fileName  String
  filePath  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id           Int           @id @default(autoincrement())
  num          String?
  paymentDate  DateTime?     @default(now())
  as           String?
  studentId    Int?
  student      Student?      @relation(fields: [studentId], references: [id])
  paymentLines PaymentLine[]
}

model PaymentLine {
  id        Int      @id @default(autoincrement())
  paymentId Int
  amount    Float
  title     String
  type      String
  numCheque String?
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Teacher {
  id        Int        @id @default(autoincrement())
  name      String?
  photo     String?
  iuense    String?
  email     String?
  phone     String?
  gender    String?
  diploma   String?
  subjectId Int?
  absences  Absence[]
  teacherAbsences TeacherAbsence[]
  notifications TeacherNotification[]
  planings  Planing[]
  schedules Schedule[]
  roomReservations RoomReservation[]
  subject   Subject?   @relation(fields: [subjectId], references: [id])
  user      User?
  classes   Class[]    @relation("ClassToTeacher")
}

model Class {
  id          Int          @id @default(autoincrement())
  name        String?
  level       String?
  codeclass   String?
  roomId      Int?         @unique
  room        Room?        @relation(fields: [roomId], references: [id])
  absences    Absence[]
  noteDevoirs NoteDevoir[]
  planings    Planing[]
  ressouces   Ressouce[]
  schedules   Schedule[]
  students    Student[]
  tafs        Taf[]
  teachers    Teacher[]    @relation("ClassToTeacher")
  teacherAbsences TeacherAbsence[] @relation("TeacherAbsenceToClass")
  billets     Billet[]
  roomReservations RoomReservation[]

  chats Chat[]
  chatBlocked Boolean? @default(false)
}

model Room {
  id        Int        @id @default(autoincrement())
  name      String?
  type      String?
  capacity  Int?
  status    String?
  schedules Schedule[]
  class     Class?
  reservations RoomReservation[]
}

// Demande de réservation d'une salle (salle de cinéma) par un enseignant, pour une
// date précise, 1 ou 2 heures consécutives. Confirmée seulement après validation
// par l'administration.
model RoomReservation {
  id         Int       @id @default(autoincrement())
  roomId     Int
  teacherId  Int
  classId    Int
  date       DateTime  // le jour, à minuit UTC (même format que Absence.dateAbsence)
  hour       String    // début : "10:00"
  duration   Int       // 1 ou 2 heures
  motif      String?
  statut     String    @default("en_attente") // "en_attente" | "validee" | "refusee" | "annulee"
  motifRefus String?
  traiteAt   DateTime?
  traitePar  String?
  createdAt  DateTime  @default(now())
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classe     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([roomId, date])
  @@index([teacherId])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  as        String?
  day       String?
  start     String?
  duration  Int?
  group     Boolean? @default(false)
  week      String?  @default("all")
  subjectId Int?
  roomId    Int?
  classId   Int?
  teacherId Int?
  class     Class?   @relation(fields: [classId], references: [id])
  room      Room?    @relation(fields: [roomId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
}

model Subject {
  id          Int          @id @default(autoincrement())
  name        String?
  codematiere String?
  hoursLevel1 Int?
  hoursLevel2 Int?
  hoursLevel3 Int?
  noteDevoirs NoteDevoir[]
  schedules   Schedule[]
  tafs        Taf[]
  teachers    Teacher[]
}

model Taf {
  id          Int       @id @default(autoincrement())
  subjectId   Int?
  classId     Int?
  type        String?
  dateTaf     DateTime?
  description String?
  class       Class?    @relation(fields: [classId], references: [id])
  subject     Subject?  @relation(fields: [subjectId], references: [id])

  files file[]
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String?
  target      Int?
  dateEvent   DateTime?
  description String?
}

model Activity {
  id           Int       @id @default(autoincrement())
  nameUser     String?
  dateActivity DateTime? @default(now())
  description  String?
}

model Absence {
  id          Int       @id @default(autoincrement())
  studentId   Int?
  classId     Int?
  teacherId   Int?
  dateAbsence DateTime?
  hour        String?
  hourEnd     String?
  status      String?   @default("absence")
  lateMinutes Int?
  validated   Boolean?  @default(false)
  validatedAt DateTime?
  // Envoi au parent de la journée d'absence auquel cette ligne est rattachée
  parentNoticeId Int?
  classe      Class?    @relation(fields: [classId], references: [id])
  student     Student?  @relation(fields: [studentId], references: [id])
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  parentNotice ParentAbsenceNotice? @relation(fields: [parentNoticeId], references: [id], onDelete: SetNull)
  billet      Billet?
}

// Billet d'entrée (élève absent qui arrive en cours de journée) ou de retard.
// Il ne supprime jamais l'absence d'où il part.
model Billet {
  id        Int      @id @default(autoincrement())
  type      String   // "entree" | "retard"
  studentId Int
  classId   Int
  date      DateTime // le jour, même format que Absence.dateAbsence
  hour      String?  // créneau où le billet s'applique ; null s'il ne reste aucun cours ce jour-là
  hourEnd   String?
  absenceId Int      @unique
  createdBy String
  createdAt DateTime @default(now())
  // Billet d'entrée : l'enseignant du cours valide l'arrivée de l'élève ou signale qu'il n'est pas venu
  statut    String   @default("en_attente") // "en_attente" | "valide" | "non_arrive"
  traiteAt  DateTime?
  traitePar String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classe    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  absence   Absence  @relation(fields: [absenceId], references: [id], onDelete: Restrict)
  notifications TeacherNotification[]

  @@index([studentId, date])
}

model TeacherNotification {
  id        Int      @id @default(autoincrement())
  teacherId Int
  type      String   // "billet"
  title     String
  message   String
  billetId  Int?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  billet    Billet?  @relation(fields: [billetId], references: [id], onDelete: SetNull)

  @@index([teacherId, read])
}

// Le parent a été prévenu de l'absence de son enfant pour ce jour-là.
// Une seule ligne par élève et par jour : c'est ce qui empêche un second envoi.
model ParentAbsenceNotice {
  id             Int      @id @default(autoincrement())
  studentId      Int
  date           DateTime
  notificationId Int?
  sentBy         String
  sentAt         DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  absences       Absence[]

  @@unique([studentId, date])
}
model TeacherAbsence {
  id         Int       @id @default(autoincrement())
  teacherId  Int
  dateStart  DateTime
  dateEnd    DateTime
  hourStart  String?
  hourEnd    String?
  reason     String?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  classes    Class[]   @relation("TeacherAbsenceToClass")
}
model AdminAlert {
  id        Int       @id @default(autoincrement())
  type      String?
  message   String
  createdAt DateTime  @default(now())
  read      Boolean   @default(false)
  readAt    DateTime?
}
model Planing {
  id                 Int                 @id @default(autoincrement())
  teacherId          Int?
  as                 String?
  name               String?
  type               String?
  datePlaning        DateTime?
  description        String?
  classId            Int?
  class              Class?              @relation(fields: [classId], references: [id])
  teacher            Teacher?            @relation(fields: [teacherId], references: [id])
  ressouces          Ressouce[]
  sessionEvaluations SessionEvaluation[]
}

model SessionEvaluation {
  id        Int      @id @default(autoincrement())
  planingId Int
  studentId Int
  note      Float
  createdAt DateTime @default(now())
  planing   Planing  @relation(fields: [planingId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planingId, studentId])
}

model Ressouce {
  id        Int      @id @default(autoincrement())
  name      String?
  planingId Int?
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  planing   Planing? @relation(fields: [planingId], references: [id])
}

model file {
  id        Int      @id @default(autoincrement())
  name      String?
  tafId     Int?
  taf       Taf?     @relation(fields: [tafId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  parentId  Int
  title     String
  message   String
  type      String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  parent    Parent   @relation(fields: [parentId], references: [id])
}

model Note {
  id             Int     @id @default(autoincrement())
  as             String?
  libperiodexam  String?
  idenelev       String?
  prenomnom      String?
  libematier     String?
  codematiere    String?
  abretypeeprear String?
  libTypeEpr     String?
  iuense         String?
  libens         String?
  libeclass      String?
  codeclass      String?
  noteepre       Float?
  codeTypeEpre   Int?
  numEpre        Int?
}

model NoteDevoir {
  id            Int      @id @default(autoincrement())
  as            String?
  libperiodexam String?
  libTypeEpr    String?
  studentId     Int?
  subjectId     Int?
  classId       Int?
  noteepre      Float?
  createdAt     DateTime @default(now())
  isAbsent      Boolean? @default(false)
  class         Class?   @relation(fields: [classId], references: [id])
  student       Student? @relation(fields: [studentId], references: [id])
  subject       Subject? @relation(fields: [subjectId], references: [id])
}

model Chat{
  id            Int      @id @default(autoincrement())
  studentId     Int?
  student       Student? @relation(fields: [studentId], references: [id])
  sendTo        Int?
  class         Class?   @relation(fields: [sendTo], references: [id])
  message       String?
  createdAt     DateTime @default(now())
}

model GlobalSetting {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  value String
}