# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

/lib/generated/prisma

/generated/prisma

/generated/prisma

.env*.local

# sauvegardes de build creees avant un deploiement
.next.bak-*/

# logs applicatifs
/logs/
*.log

# sauvegardes de fichiers faites avant une modification (desormais dans /var/backups/leaders/)
*.bak-*
lib/generated.bak-*/
